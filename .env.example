# Copy to .env and edit if needed.

# Where the simulator runs, seen from inside the container.
#   Linux:       127.0.0.1
#   Mac/Windows: host.docker.internal
IFSSIM_HOST=127.0.0.1
IFSSIM_PORT=41451

# Absolute path of this repo's tracks/ folder ON YOUR HOST, in the format
# the simulator understands. Only needed if `sim load` can't find tracks
# (typically Windows: use C:/Users/you/IFS-DV-SANDBOX/tracks).
# HOST_TRACKS_DIR=

# ROS_DOMAIN_ID=0
